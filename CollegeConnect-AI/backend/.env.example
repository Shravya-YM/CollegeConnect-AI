# CollegeConnect AI Configuration - Vidyavardhaka College of Engineering (VVCE)

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & LLM Models
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ChromaDB Settings
CHROMA_PERSIST_DIR=./data/chromadb
COLLECTION_NAME=vvce_knowledge_base

# Security & Admin Access
ADMIN_API_KEY=vvce_admin_secret_key_change_me
RATE_LIMIT_PER_MINUTE=20/minute

# Allowed CORS Origins (Comma-separated, or * for all during local development)
ALLOWED_ORIGINS=*

# Grounding & Evidence Sufficiency Threshold (0.0 to 1.0)
EVIDENCE_THRESHOLD=0.65
TOP_K_RETRIEVAL=4
